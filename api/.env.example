SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Legacy HS256 projects: set the JWT secret. Projects on asymmetric signing keys: leave blank and JWKS
# at {SUPABASE_URL}/auth/v1/.well-known/jwks.json is used.
SUPABASE_JWT_SECRET=
# Direct Postgres for app/db.py. Dashboard → Connect → "Session pooler" (IPv4). Direct db.<ref> host is IPv6-only.
# postgresql://postgres.<ref>:<db-password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres
DATABASE_URL=
# Enables taxonomy loading and location/season re-ranking of photo candidates.
EBIRD_API_KEY=
MAPBOX_TOKEN=
LLM_PROVIDER=meta
META_LLM_API_KEY=
META_LLM_BASE_URL=
META_TEXT_MODEL=
META_VISION_MODEL=
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=
# Set LLM_PROVIDER=openai and OPENAI_API_KEY to enable photo identification.
OPENAI_VISION_MODEL=gpt-6-astra
MIN_CONF=0.6
ANOMALY_CONF=0.85
DEFAULT_LAT=33.749
DEFAULT_LNG=-84.388
# Comma-separated origins allowed by CORS (the Vercel URL + local dev)
CORS_ORIGINS=http://localhost:5173
